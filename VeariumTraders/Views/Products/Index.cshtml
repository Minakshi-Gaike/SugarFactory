@{
    ViewData["Title"] = "Products";
}

<!-- ================= PRODUCT HERO ================= -->

<section class="products-page-hero">

    <div class="products-page-overlay">

        <div class="container">

            <div class="products-page-hero-content">

                <span>
                    VEARIUM TRADERS
                </span>

                <h1>
                    Our <strong>Products</strong>
                </h1>

                <p>
                    Quality agricultural commodities for reliable
                    bulk trading and supply requirements.
                </p>

            </div>

        </div>

    </div>

</section>


<!-- ================= PRODUCTS INTRO ================= -->

<section class="products-intro-section">

    <div class="container">

        <div class="products-intro text-center">

            <span class="products-page-label">
                OUR COMMODITIES
            </span>

            <h2>
                Quality Agricultural
                <strong>Commodities</strong>
            </h2>

            <p>
                Vearium Traders supplies quality agricultural commodities
                with a focus on reliable supply, competitive pricing and
                dependable business partnerships.
            </p>

        </div>

    </div>

</section>


<!-- ================= PRODUCT CARDS ================= -->

<section class="products-list-section">

    <div class="container">

        <div class="row g-4">


            <!-- MAIZE -->

            <div class="col-12 col-md-6 col-lg-4">

                <div class="products-page-card">

                    <div class="products-page-image">

                        <img src="~/images/products/maize.jpg"
                             alt="Maize" />

                    </div>

                    <div class="products-page-card-content">

                        <span class="product-number">
                            01
                        </span>

                        <h3>
                            Maize
                        </h3>

                        <p>
                            Quality maize available for bulk
                            agricultural commodity requirements.
                        </p>

                        <a asp-controller="Enquiry"
                           asp-action="Index"
                           class="product-enquiry-btn">
                            Enquire Now
                            <span>→</span>
                        </a>

                    </div>

                </div>

            </div>


            <!-- SUGAR -->

            <div class="col-12 col-md-6 col-lg-4">

                <div class="products-page-card">

                    <div class="products-page-image">

                        <img src="~/images/products/sugar.jpg"
                             alt="Sugar" />

                    </div>

                    <div class="products-page-card-content">

                        <span class="product-number">
                            02
                        </span>

                        <h3>
                            Sugar
                        </h3>

                        <p>
                            Reliable sugar supply for bulk trading
                            and business requirements.
                        </p>

                        <a asp-controller="Enquiry"
                           asp-action="Index"
                           class="product-enquiry-btn">
                            Enquire Now
                            <span>→</span>
                        </a>

                    </div>

                </div>

            </div>


            <!-- JAGGERY -->

            <div class="col-12 col-md-6 col-lg-4">

                <div class="products-page-card">

                    <div class="products-page-image">

                        <img src="~/images/products/jaggery.jpg"
                             alt="Jaggery" />

                    </div>

                    <div class="products-page-card-content">

                        <span class="product-number">
                            03
                        </span>

                        <h3>
                            Jaggery
                        </h3>

                        <p>
                            Quality jaggery products for dependable
                            bulk supply requirements.
                        </p>

                        <a asp-controller="Enquiry"
                           asp-action="Index"
                           class="product-enquiry-btn">
                            Enquire Now
                            <span>→</span>
                        </a>

                    </div>

                </div>

            </div>


            <!-- JAGGERY POWDER -->

            <div class="col-12 col-md-6 col-lg-4">

                <div class="products-page-card">

                    <div class="products-page-image">

                        <img src="~/images/products/jaggery-powder.jpg"
                             alt="Jaggery Powder" />

                    </div>

                    <div class="products-page-card-content">

                        <span class="product-number">
                            04
                        </span>

                        <h3>
                            Jaggery Powder
                        </h3>

                        <p>
                            Convenient jaggery powder suitable for
                            bulk sourcing requirements.
                        </p>

                        <a asp-controller="Enquiry"
                           asp-action="Index"
                           class="product-enquiry-btn">
                            Enquire Now
                            <span>→</span>
                        </a>

                    </div>

                </div>

            </div>


            <!-- COCONUT SHELL -->

            <div class="col-12 col-md-6 col-lg-4">

                <div class="products-page-card">

                    <div class="products-page-image">

                        <img src="~/images/products/coconut-shell.jpg"
                             alt="Coconut Shell" />

                    </div>

                    <div class="products-page-card-content">

                        <span class="product-number">
                            05
                        </span>

                        <h3>
                            Coconut Shell
                        </h3>

                        <p>
                            Quality coconut shell products available
                            for bulk supply requirements.
                        </p>

                        <a asp-controller="Enquiry"
                           asp-action="Index"
                           class="product-enquiry-btn">
                            Enquire Now
                            <span>→</span>
                        </a>

                    </div>

                </div>

            </div>


        </div>

    </div>

</section>


<!-- ================= BULK ENQUIRY CTA ================= -->

<section class="products-cta-section">

    <div class="container">

        <div class="products-cta-content text-center">

            <span>
                BULK REQUIREMENT?
            </span>

            <h2>
                Looking for Reliable Agricultural Commodities?
            </h2>

            <p>
                Connect with Vearium Traders for your bulk
                agricultural commodity requirements.
            </p>

            <a asp-controller="Enquiry"
               asp-action="Index"
               class="products-cta-btn">
                Get Bulk Enquiry
                <span>→</span>
            </a>

        </div>

    </div>

</section>