
@{
    ViewData["Title"] = "Contact Us";
}

<div class="container py-5">

    <div class="text-center mb-4">
        <h2>Contact Us</h2>
        <p>
            Get in touch with our team for agricultural commodities,
            bulk orders, vendor registration and business opportunities.
        </p>
    </div>

    @if (ViewBag.Success != null)
    {
        <div class="alert alert-success">
            @ViewBag.Success
        </div>
    }

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">
            @ViewBag.Error
        </div>
    }

    <div class="row g-4">

        <!-- Contact Form -->
        <div class="col-lg-6">
            <div class="card shadow-sm h-100">
                <div class="card-body p-4">

                    <h4 class="mb-2">Get in Touch</h4>
                    <p class="text-muted">
                        Fill out the form and our team will contact you.
                    </p>

                    <form asp-controller="Contact"
                          asp-action="Index"
                          method="post">

                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label class="form-label">Full Name *</label>
                            <input name="fullName"
                                   class="form-control"
                                   maxlength="100"
                                   required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Email Address *</label>
                            <input type="email"
                                   name="email"
                                   class="form-control"
                                   maxlength="150"
                                   required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Contact Number *</label>
                            <input type="tel"
                                   name="mobile"
                                   class="form-control"
                                   maxlength="15"
                                   required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Company Name</label>
                            <input name="companyName"
                                   class="form-control"
                                   maxlength="150" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Service Inquiry *</label>
                            <select name="serviceInquiry"
                                    class="form-select"
                                    required>
                                <option value="">Select Service</option>
                                <option>Bulk Commodity Enquiry</option>
                                <option>Vendor Registration</option>
                                <option>Agriculture Trading</option>
                                <option>Product Information</option>
                                <option>Other Inquiry</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Your Message *</label>
                            <textarea name="message"
                                      class="form-control"
                                      rows="4"
                                      maxlength="2000"
                                      required></textarea>
                        </div>

                        <button type="submit"
                                class="btn btn-success w-100">
                            Send Message
                        </button>

                    </form>

                    <hr />

                    <div class="text-center">
                        <p class="mb-2">Prefer to contact us directly?</p>
                        <p class="mb-0">
                            <a href="tel:+919028215279">
                                +91 9028215279
                            </a>
                            <br />
                            <a href="mailto:veariumtraders@gmail.com">
                                veariumtraders@gmail.com
                            </a>
                        </p>
                    </div>

                </div>
            </div>
        </div>

        <!-- Office Details -->
        <div class="col-lg-6">

            <div class="card shadow-sm mb-4">
                <div class="card-body p-4">
                    <h4>Our Offices</h4>

                    <h6 class="mt-3">Head Office</h6>
                    <p class="mb-1">
                        Pune, Maharashtra, India
                    </p>
                    <p class="mb-1">
                        Phone: +91 9028215279
                    </p>
                    <p class="mb-0">
                        Email: veariumtraders@gmail.com
                    </p>
                </div>
            </div>

            <div class="card shadow-sm mb-4">
                <div class="card-body p-4">
                    <h4>Department Contacts</h4>

                    <div class="row g-3 mt-1">
                        <div class="col-md-6">
                            <div class="p-3 bg-light rounded">
                                <h6>Bulk Enquiries</h6>
                                <p class="mb-0 small">
                                    For bulk orders and product pricing.
                                </p>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="p-3 bg-light rounded">
                                <h6>Vendor Registration</h6>
                                <p class="mb-0 small">
                                    For suppliers and business partners.
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <h4>Frequently Asked Questions</h4>

                    <div class="mt-3">
                        <h6>What is your response time?</h6>
                        <p class="text-muted">
                            Our team will contact you as soon as possible
                            during business hours.
                        </p>
                    </div>

                    <hr />

                    <div>
                        <h6>Do you accept bulk orders?</h6>
                        <p class="text-muted">
                            Yes, submit your product and quantity
                            requirements through our enquiry form.
                        </p>
                    </div>

                    <hr />

                    <div>
                        <h6>How can I become a vendor?</h6>
                        <p class="text-muted mb-0">
                            Use the Vendor Registration option on our website
                            to share your supplier details.
                        </p>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>