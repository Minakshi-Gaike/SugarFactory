@{
    ViewData["Title"] = "Contact Us";
}

<style>
    .vt-contact {
        background: #f8f9f7;
        color: #243249;
        padding-bottom: 55px;
    }

    .vt-contact-hero {
        position: relative;
        isolation: isolate;
        min-height: 300px;
        padding: 65px 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        background-image: linear-gradient(rgba(0, 0, 0, 0.48), rgba(0, 0, 0, 0.48)), url('/images/contact-bg.jpg');
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        border-bottom: 1px solid #eee8df;
    }

        .vt-contact-hero > .container {
            width: 100%;
        }

        .vt-contact-hero .breadcrumb-text {
            color: #7b8492;
            font-size: 13px;
            margin-bottom: 12px;
        }

            .vt-contact-hero .breadcrumb-text span {
                color: #e85b24;
            }

        .vt-contact-hero h1 {
            font-size: clamp(36px, 4vw, 54px);
            font-weight: 800;
            color: #ffffff;
            margin-bottom: 16px;
            text-shadow: 0 2px 8px rgba(0, 0, 0, 0.45);
        }

            .vt-contact-hero h1 span {
                color: #ff641f;
            }

        .vt-contact-hero p {
            max-width: 760px;
            color: #ffffff;
            line-height: 1.8;
            margin: 0 auto;
            font-size: clamp(15px, 1.4vw, 19px);
            text-shadow: 0 2px 6px rgba(0, 0, 0, 0.85);
        }

    .vt-contact-content {
        padding-top: 32px;
    }

    .vt-contact-card {
        background: #fff;
        border: 1px solid #e7e9e5;
        border-radius: 12px;
        box-shadow: 0 5px 20px rgba(25, 38, 60, .045);
        overflow: hidden;
    }

    .vt-contact-card-body {
        padding: 25px;
    }

    .vt-section-heading {
        display: flex;
        align-items: center;
        gap: 13px;
        margin-bottom: 22px;
    }

    .vt-heading-icon {
        width: 48px;
        height: 48px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        background: #fff0e7;
        color: #ed6128;
        font-size: 22px;
    }

        .vt-heading-icon.green {
            color: #388348;
            background: #edf6ee;
        }

        .vt-heading-icon.blue {
            color: #2679b7;
            background: #edf5fc;
        }

    .vt-section-heading h2 {
        font-size: 21px;
        font-weight: 750;
        color: #172641;
        margin: 0 0 5px;
    }

    .vt-section-heading p {
        font-size: 13px;
        color: #7b8494;
        margin: 0;
        line-height: 1.6;
    }

    .vt-contact .form-label {
        color: #354158;
        font-size: 13px;
        font-weight: 650;
        margin-bottom: 7px;
    }

    .vt-contact .required-mark {
        color: #ed6128;
    }

    .vt-contact .form-control,
    .vt-contact .form-select {
        min-height: 43px;
        border: 1px solid #dce1e8;
        border-radius: 7px;
        background-color: #fff;
        font-size: 14px;
        color: #29364c;
        box-shadow: none;
    }

    .vt-contact textarea.form-control {
        min-height: 110px;
        resize: vertical;
    }

    .vt-contact .form-control:focus,
    .vt-contact .form-select:focus {
        border-color: #ed8a5f;
        box-shadow: 0 0 0 3px rgba(237, 97, 40, .09);
    }

    .vt-contact .form-control::placeholder {
        color: #a0a8b5;
    }

    .vt-submit-btn {
        width: 100%;
        min-height: 46px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        border: none;
        border-radius: 7px;
        background: #ed6128;
        color: #fff;
        font-size: 14px;
        font-weight: 700;
        transition: background .2s, transform .2s;
    }

        .vt-submit-btn:hover {
            background: #d84f18;
            transform: translateY(-1px);
            color: #fff;
        }

    .vt-direct-contact {
        display: flex;
        align-items: flex-start;
        gap: 13px;
        margin-top: 22px;
        padding: 17px;
        border-radius: 9px;
        background: #fff7f1;
        border: 1px solid #f6e7db;
    }

        .vt-direct-contact .direct-icon {
            width: 42px;
            height: 42px;
            flex-shrink: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            background: #ffe6d7;
            color: #e85b24;
            font-size: 19px;
        }

        .vt-direct-contact strong {
            display: block;
            font-size: 13px;
            color: #27364c;
            margin-bottom: 5px;
        }

        .vt-direct-contact a {
            display: block;
            color: #d95520;
            text-decoration: none;
            font-size: 13px;
            margin-top: 4px;
            overflow-wrap: anywhere;
        }

            .vt-direct-contact a:hover {
                text-decoration: underline;
            }

    .vt-office-item {
        display: flex;
        gap: 12px;
        align-items: flex-start;
        padding: 12px 0;
        border-bottom: 1px solid #edf0f2;
    }

        .vt-office-item:last-child {
            border-bottom: none;
            padding-bottom: 0;
        }

        .vt-office-item > i {
            color: #ed6128;
            font-size: 18px;
            margin-top: 2px;
        }

        .vt-office-item strong {
            display: block;
            font-size: 13px;
            color: #27364c;
            margin-bottom: 3px;
        }

        .vt-office-item p {
            color: #778195;
            font-size: 13px;
            line-height: 1.6;
            margin: 0;
            overflow-wrap: anywhere;
        }

    .vt-department {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 15px;
        background: #f7faf6;
        border: 1px solid #e8eee5;
        border-radius: 9px;
        height: 100%;
    }

        .vt-department .department-icon {
            width: 42px;
            height: 42px;
            flex-shrink: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 9px;
            background: #e8f3e7;
            color: #398048;
            font-size: 20px;
        }

        .vt-department h3 {
            color: #26364c;
            font-size: 14px;
            font-weight: 750;
            margin: 0 0 5px;
        }

        .vt-department p {
            color: #758095;
            font-size: 12px;
            line-height: 1.6;
            margin: 0;
        }

    .vt-faq-item {
        padding: 14px 0;
        border-bottom: 1px solid #e9edf0;
    }

        .vt-faq-item:last-child {
            border-bottom: none;
            padding-bottom: 0;
        }

        .vt-faq-item summary {
            color: #28364c;
            font-size: 14px;
            font-weight: 650;
            cursor: pointer;
            line-height: 1.6;
        }

            .vt-faq-item summary::marker {
                color: #ed6128;
            }

        .vt-faq-item p {
            color: #778195;
            font-size: 13px;
            line-height: 1.7;
            margin: 9px 0 0;
        }

    .vt-contact .alert {
        border-radius: 8px;
        font-size: 14px;
    }

    @@media (max-width: 767px) {
        .vt-contact-hero {
            min-height: 250px;
            padding: 45px 18px;
            background-position: center;
        }

        .vt-contact-content {
            padding-top: 20px;
        }

        .vt-contact-card-body {
            padding: 19px;
        }

        .vt-section-heading h2 {
            font-size: 19px;
        }
    }
</style>

<div class="vt-contact">

    <!-- Page Heading -->

    <div class="vt-contact-hero text-center">
        <div class="container">
            <div class="vt-contact-breadcrumb">
                @* <a asp-controller="Home" asp-action="Index">Home</a> *@
                @* <span>/</span> *@
                @* <span>Contact Us</span> *@
            </div>

            <h1 class="vt-contact-title">
                Contact <span>Us</span>
            </h1>

            <p class="vt-contact-subtitle">
                Get in touch with our team for agricultural commodities,
                bulk orders, vendor registration and business opportunities.
            </p>
        </div>
    </div>


    <div class="container vt-contact-content">

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show mb-4"
                 role="alert">
                @TempData["SuccessMessage"]

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert"
                        aria-label="Close">
                </button>
            </div>
        }

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger mb-4" role="alert">
                @ViewBag.Error
            </div>
        }

        <div class="row g-4">

            <!-- Contact Form -->
            <div class="col-lg-6">
                <div class="vt-contact-card h-100">
                    <div class="vt-contact-card-body">

                        <div class="vt-section-heading">
                            <div class="vt-heading-icon">
                                <i class="bi bi-envelope"></i>
                            </div>
                            <div>
                                <h2>Get in Touch</h2>
                                <p>Fill out the form and our team will contact you.</p>
                            </div>
                        </div>

                        <form asp-controller="Contact"
                              asp-action="Index"
                              method="post">

                            @Html.AntiForgeryToken()

                            <div class="mb-3">
                                <label class="form-label">
                                    Full Name <span class="required-mark">*</span>
                                </label>
                                <input name="fullName"
                                       class="form-control"
                                       maxlength="100"
                                       placeholder="Enter your full name"
                                       required />
                            </div>

                            <div class="mb-3">
                                <label class="form-label">
                                    Email Address <span class="required-mark">*</span>
                                </label>
                                <input type="email"
                                       name="email"
                                       class="form-control"
                                       maxlength="150"
                                       placeholder="name@example.com"
                                       required />
                            </div>

                            <div class="mb-3">
                                <label class="form-label">
                                    Contact Number <span class="required-mark">*</span>
                                </label>
                                <input type="tel"
                                       name="mobile"
                                       class="form-control"
                                       maxlength="15"
                                       placeholder="Enter your contact number"
                                       required />
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Company Name</label>
                                <input name="companyName"
                                       class="form-control"
                                       maxlength="150"
                                       placeholder="Enter your company name" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label">
                                    Service Inquiry <span class="required-mark">*</span>
                                </label>
                                <select name="serviceInquiry"
                                        class="form-select"
                                        required>
                                    <option value="">Select Service</option>
                                    <option>Bulk Commodity Enquiry</option>
                                    <option>Vendor Registration</option>
                                    <option>Agriculture Trading</option>
                                    <option>Product Information</option>
                                    <option>Other Inquiry</option>
                                </select>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">
                                    Your Message <span class="required-mark">*</span>
                                </label>
                                <textarea name="message"
                                          class="form-control"
                                          rows="4"
                                          maxlength="2000"
                                          placeholder="Tell us about your requirements..."
                                          required></textarea>
                            </div>

                            <button type="submit" class="vt-submit-btn">
                                <i class="bi bi-send-fill"></i>
                                Send Message
                            </button>

                        </form>

                        <div class="vt-direct-contact">
                            <div class="direct-icon">
                                <i class="bi bi-telephone-fill"></i>
                            </div>
                            <div>
                                <strong>Prefer to contact us directly?</strong>
                                <a href="tel:+919028215279">+91 9028215279</a>
                                <a href="mailto:veariumtraders@gmail.com">
                                    veariumtraders@gmail.com
                                </a>
                            </div>
                        </div>

                    </div>
                </div>
            </div>

            <!-- Right Side Information -->
            <div class="col-lg-6">

                <!-- Offices -->
                <div class="vt-contact-card mb-4">
                    <div class="vt-contact-card-body">

                        <div class="vt-section-heading">
                            <div class="vt-heading-icon">
                                <i class="bi bi-geo-alt"></i>
                            </div>
                            <div>
                                <h2>Our Offices</h2>
                                <p>Connect with our team.</p>
                            </div>
                        </div>

                        <div class="vt-office-item">
                            <i class="bi bi-building"></i>
                            <div>
                                <strong>Head Office</strong>
                                <p>Pune, Maharashtra, India</p>
                            </div>
                        </div>

                        <div class="vt-office-item">
                            <i class="bi bi-telephone"></i>
                            <div>
                                <strong>Phone</strong>
                                <p>+91 9028215279</p>
                            </div>
                        </div>

                        <div class="vt-office-item">
                            <i class="bi bi-envelope"></i>
                            <div>
                                <strong>Email Address</strong>
                                <p>veariumtraders@gmail.com</p>
                            </div>
                        </div>

                    </div>
                </div>

                <!-- Departments -->
                <div class="vt-contact-card mb-4">
                    <div class="vt-contact-card-body">

                        <div class="vt-section-heading">
                            <div class="vt-heading-icon green">
                                <i class="bi bi-people"></i>
                            </div>
                            <div>
                                <h2>Department Contacts</h2>
                                <p>Find the right team for your requirements.</p>
                            </div>
                        </div>

                        <div class="row g-3">

                            <div class="col-md-6">
                                <div class="vt-department">
                                    <div class="department-icon">
                                        <i class="bi bi-box-seam"></i>
                                    </div>
                                    <div>
                                        <h3>Bulk Enquiries</h3>
                                        <p>For bulk orders and product pricing.</p>
                                    </div>
                                </div>
                            </div>

                           
                            <div class="col-md-6">
                                <div class="p-3 bg-light rounded d-flex align-items-center gap-3">
                                    <div class="contact-department-icon">
                                        <i class="bi bi-person-vcard"></i>
                                    </div>
                                    <div>
                                        <h6 class="mb-1">Vendor Registration</h6>
                                        <p class="mb-0 small">For suppliers and business partners.</p>
                                    </div>
                                </div>
                            </div>


                        </div>
                    </div>
                </div>

                <!-- FAQs -->
                <div class="vt-contact-card">
                    <div class="vt-contact-card-body">

                        <div class="vt-section-heading">
                            <div class="vt-heading-icon blue">
                                <i class="bi bi-question-circle"></i>
                            </div>
                            <div>
                                <h2>Frequently Asked Questions</h2>
                                <p>Quick answers to common questions.</p>
                            </div>
                        </div>

                        <details class="vt-faq-item">
                            <summary>What is your response time?</summary>
                            <p>
                                Our team will contact you as soon as possible
                                during business hours.
                            </p>
                        </details>

                        <details class="vt-faq-item">
                            <summary>Do you accept bulk orders?</summary>
                            <p>
                                Yes, submit your product and quantity requirements
                                through our enquiry form.
                            </p>
                        </details>

                        <details class="vt-faq-item">
                            <summary>How can I become a vendor?</summary>
                            <p>
                                Contact our team to discuss supplier registration
                                and business partnership opportunities.
                            </p>
                        </details>

                    </div>
                </div>

            </div>
        </div>
    </div>
</div>
