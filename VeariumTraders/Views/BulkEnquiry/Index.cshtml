@model VeariumTraders.Models.BulkEnquiry

@{
    ViewData["Title"] = "Bulk Enquiry";
}

<section class="enquiry-page">
    <div class="container">

        <div class="enquiry-header text-center">
            <span>VEARIUM TRADERS</span>
            <h1><strong>Get Bulk Enquiry</strong></h1>
            <p>
                Share your agricultural commodity requirements
                with us and our team will get back to you.
            </p>
        </div>

        <div class="row justify-content-center">
            <div class="col-lg-8">

                <div class="enquiry-card">

                    <form asp-controller="BulkEnquiry"
                          asp-action="Index"
                          method="post">

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3"></div>

                        @if (TempData["SuccessMessage"] != null)
                        {
                            <div class="alert alert-success" role="alert">
                                @TempData["SuccessMessage"]
                            </div>
                        }

                        <div class="row g-3">

                            <div class="col-md-6">
                                <label asp-for="FullName"
                                       class="form-label">Your Name</label>
                                <input asp-for="FullName"
                                       class="form-control"
                                       placeholder="Enter your name" />
                                <span asp-validation-for="FullName"
                                      class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="CompanyName"
                                       class="form-label">Company Name</label>
                                <input asp-for="CompanyName"
                                       class="form-control"
                                       placeholder="Enter company name" />
                            </div>

                            <div class="col-md-6">
                                <label asp-for="MobileNumber"
                                       class="form-label">Mobile Number</label>
                                <input asp-for="MobileNumber"
                                       type="tel"
                                       class="form-control"
                                       placeholder="Enter mobile number" />
                                <span asp-validation-for="MobileNumber"
                                      class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="EmailAddress"
                                       class="form-label">Email Address</label>
                                <input asp-for="EmailAddress"
                                       type="email"
                                       class="form-control"
                                       placeholder="Enter email address" />
                                <span asp-validation-for="EmailAddress"
                                      class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="ProductName"
                                       class="form-label">Select Product</label>
                                <select asp-for="ProductName"
                                        class="form-select">
                                    <option value="">Select product</option>
                                    <option value="Maize">Maize</option>
                                    <option value="Sugar">Sugar</option>
                                    <option value="Jaggery">Jaggery</option>
                                    <option value="Jaggery Powder">Jaggery Powder</option>
                                    <option value="Coconut Shell">Coconut Shell</option>
                                    <option value="Oil">Oil</option>
                                </select>
                                <span asp-validation-for="ProductName"
                                      class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="RequiredQuantity"
                                       class="form-label">Required Quantity</label>

                                <div class="row g-2">
                                    <div class="col-7">
                                        <input asp-for="RequiredQuantity"
                                               type="number"
                                               step="0.01"
                                               min="0.01"
                                               class="form-control"
                                               placeholder="Enter quantity" />
                                    </div>

                                    <div class="col-5">
                                        <select asp-for="QuantityUnit"
                                                class="form-select">
                                            <option value="">Unit</option>
                                            <option value="kg">Kilogram (KG)</option>
                                            <option value="quintal">Quintal (Q)</option>
                                            <option value="mt">Metric Ton (MT)</option>
                                            <option value="other">Other</option>
                                        </select>
                                    </div>
                                </div>

                                <span asp-validation-for="RequiredQuantity"
                                      class="text-danger"></span>
                                <span asp-validation-for="QuantityUnit"
                                      class="text-danger"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="DeliveryLocation"
                                       class="form-label">Delivery Location</label>
                                <input asp-for="DeliveryLocation"
                                       class="form-control"
                                       placeholder="Enter delivery location" />
                            </div>

                            <div class="col-12">
                                <label asp-for="RequirementDetails"
                                       class="form-label">
                                    Describe Your Requirement
                                </label>
                                <textarea asp-for="RequirementDetails"
                                          class="form-control"
                                          rows="5"
                                          placeholder="Describe your requirement..."></textarea>
                            </div>

                            <div class="col-12 text-center">
                                <button type="submit"
                                        class="enquiry-submit-btn">
                                    Submit Bulk Enquiry
                                    <span>→</span>
                                </button>
                            </div>

                        </div>
                    </form>

                </div>
            </div>
        </div>
    </div>
</section>
