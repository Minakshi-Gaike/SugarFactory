<!-- CERTIFICATIONS & COMPLIANCE SECTION -->
<section class="certifications-section">
    <div class="certifications-container">

        <h2 class="certifications-title">
            Certifications &amp; Compliance
        </h2>

        <div class="certifications-grid">

            <!-- ISO Certification -->
            <div class="certification-card featured">
                <div class="certification-heading">
                    <div class="certification-check">✓</div>
                    <h3>ISO 22000:2018</h3>
                </div>
                <p>Food Safety Management System</p>
            </div>

            <!-- FSSAI Certification -->
            <div class="certification-card">
                <div class="certification-heading">
                    <div class="certification-check">✓</div>
                    <h3>FSSAI Certified</h3>
                </div>
                <p>Food Safety &amp; Compliance Authority</p>
            </div>

            <!-- APEDA Registration -->
            <div class="certification-card">
                <div class="certification-heading">
                    <div class="certification-check">✓</div>
                    <h3>APEDA Registered</h3>
                </div>
                <p>Agricultural &amp; Processed Food Export Council</p>
            </div>

        </div>
    </div>
</section>
