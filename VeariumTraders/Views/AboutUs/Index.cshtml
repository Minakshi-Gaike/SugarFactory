    <div class="leadership-container">

        <div class="leadership-heading">
            <span class="leadership-eyebrow">LEADERSHIP &amp; PARTNERSHIP</span>
            <h2>Business <span>Leadership</span></h2>
            <p>
                Vearium Traders is supported by the commitment and vision
                of its business leadership and trusted partners.
            </p>
        </div>

        <!-- Business Leadership -->
        <div class="leadership-cards">

            <div class="leadership-card">
                <div class="leadership-avatar">ND</div>
                <div class="leadership-info">
                    <span class="leadership-label">BUSINESS LEADERSHIP</span>
                    <h3>Mr. Netaji Desai</h3>
                    <p>Business Leadership &amp; Management</p>
                </div>
            </div>

            <div class="leadership-card">
                <div class="leadership-avatar">VD</div>
                <div class="leadership-info">
                    <span class="leadership-label">BUSINESS LEADERSHIP</span>
                    <h3>Mrs. Vanita Desai</h3>
                    <p>Business Leadership &amp; Management</p>
                </div>
            </div>

        </div>

        <!-- Strategic Business Partner -->
        <div class="partner-heading">
            <span class="leadership-eyebrow">OUR TRUSTED PARTNER</span>
            <h2>Strategic Business <span>Partner</span></h2>
        </div>

        <div class="partner-card">
            <div class="leadership-avatar">SB</div>
            <div class="leadership-info">
                <span class="leadership-label">TRUSTED PARTNER</span>
                <h3>Shree Venkateswara Balaji</h3>
                <p>Strategic Business Partner</p>
            </div>
        </div>

        <p class="leadership-footer">
            Together, we are focused on building a reliable and professional
            network for agro products trading, procurement and bulk supply.
        </p>

    </div>
</section>

<!-- CERTIFICATIONS & COMPLIANCE SECTION -->
<section class="certifications-section">
    <div class="certifications-container">

        <h2 class="certifications-title">
            Certifications &amp; Compliance
        </h2>

        <div class="certifications-grid">

            <!-- ISO Certification -->
            <div class="certification-card featured">
                <div class="certification-heading">
                    <div class="certification-check">✓</div>
                    <h3>ISO 22000:2018</h3>
                </div>
                <p>Food Safety Management System</p>
            </div>

            <!-- FSSAI Certification -->
            <div class="certification-card">
                <div class="certification-heading">
                    <div class="certification-check">✓</div>
                    <h3>FSSAI Certified</h3>
                </div>
                <p>Food Safety &amp; Compliance Authority</p>
            </div>

            <!-- APEDA Registration -->
            <div class="certification-card">
                <div class="certification-heading">
                    <div class="certification-check">✓</div>
                    <h3>APEDA Registered</h3>
                </div>
                <p>Agricultural &amp; Processed Food Export Council</p>
            </div>

        </div>
    </div>
</section>
