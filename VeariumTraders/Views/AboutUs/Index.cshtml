@{
    ViewData["Title"] = "About Us";
}

<!-- ================= ABOUT HERO ================= -->

<section class="about-page-hero">

    <div class="about-page-overlay">

        <div class="container">

            <div class="about-page-hero-content">

                <span>
                    VEARIUM TRADERS
                </span>

                <h1>
                    About <strong>Us</strong>
                </h1>

                <p>
                    Agricultural Commodity Trading & Bulk Supply
                </p>

            </div>

        </div>

    </div>

</section>


<!-- ================= COMPANY INTRODUCTION ================= -->

<section class="about-company-section">

    <div class="container">

        <div class="row align-items-center g-5">

            <!-- Content -->

            <div class="col-lg-7">

                <div class="about-company-content">

                    <span class="about-page-label">
                        ABOUT VEARIUM TRADERS
                    </span>

                    <h2>
                        Building Reliable Partnerships
                        in <strong>Agro Trading</strong>
                    </h2>

                    <p>
                        Vearium Traders is a proprietorship business engaged
                        in agricultural commodity trading, procurement and
                        bulk supply. The business started its journey in
                        <strong>December 2022</strong> with a focus on building
                        reliable relationships with customers, suppliers and
                        business partners.
                    </p>

                    <p>
                        We are focused on developing long-term
                        relationships with customers, suppliers and
                        business partners while delivering dependable
                        agro supply solutions.
                    </p>

                </div>

            </div>


            <!-- Established Card -->

            <div class="col-lg-5">

                <div class="about-established-card">

                    <span>
                        ESTABLISHED
                    </span>

                    <h3>
                        December
                        <strong>2022</strong>
                    </h3>

                    <p>
                        Vearium Traders
                    </p>

                    <div class="about-established-line"></div>

                    <small>
                        Agricultural Commodity Trading
                        & Bulk Supply
                    </small>

                </div>

            </div>

        </div>

    </div>

</section>


<!-- ================= LEADERSHIP & PARTNERSHIP ================= -->

<section class="leadership-section">

    <div class="container">

        <div class="leadership-heading text-center">

            <span>
                LEADERSHIP & PARTNERSHIP
            </span>

            <h2>
                Business <strong>Leadership</strong>
            </h2>

            <p>
                Vearium Traders is supported by the commitment
                and vision of its business leadership and
                trusted partners.
            </p>

        </div>


        <!-- Leadership Cards -->

        <div class="row justify-content-center g-4">


            <!-- Mr. Netaji Desai -->

            <div class="col-12 col-md-6 col-lg-5">

                <div class="leadership-card">

                    <div class="leadership-icon">
                        ND
                    </div>

                    <div class="leadership-card-content">

                        <span>
                            BUSINESS LEADERSHIP
                        </span>

                        <h3>
                            Mr. Netaji Desai
                        </h3>

                        <p>
                            Business Leadership &
                            Management
                        </p>

                    </div>

                </div>

            </div>


            <!-- Mrs. Vanita Desai -->

            <div class="col-12 col-md-6 col-lg-5">

                <div class="leadership-card">

                    <div class="leadership-icon">
                        VD
                    </div>

                    <div class="leadership-card-content">

                        <span>
                            BUSINESS LEADERSHIP
                        </span>

                        <h3>
                            Mrs. Vanita Desai
                        </h3>

                        <p>
                            Business Leadership &
                            Management
                        </p>

                    </div>

                </div>

            </div>

        </div>


        <!-- Trusted Partner -->

        <div class="partner-heading text-center">

            <span>
                OUR TRUSTED PARTNER
            </span>

            <h2>
                Strategic Business <strong>Partner</strong>
            </h2>

        </div>


        <div class="row justify-content-center">

            <div class="col-12 col-md-8 col-lg-6">

                <div class="partner-card">

                    <div class="partner-icon">
                        SB
                    </div>

                    <div>

                        <span>
                            TRUSTED PARTNER
                        </span>

                        <h3>
                            Shree Venkateswara Balaji
                        </h3>

                        <p>
                            Strategic Business Partner
                        </p>

                    </div>

                </div>

            </div>

        </div>


        <div class="leadership-description text-center">

            <p>
                Together, we are focused on building a reliable
                and professional network for agro products
                trading, procurement and bulk supply.
            </p>

        </div>

    </div>

</section>


<!-- ================= PARTNERSHIP PHILOSOPHY ================= -->

<section class="philosophy-section">

    <div class="container">

        <div class="philosophy-box">

            <div class="philosophy-content text-center">

                <span>
                    OUR PARTNERSHIP PHILOSOPHY
                </span>

                <h2>
                    Trust • Transparency • Commitment
                </h2>

                <h3>
                    Quality • Mutual Growth
                </h3>

                <p>
                    We believe strong partnerships are the
                    foundation of sustainable business growth.
                    Our objective is to create long-term
                    relationships with customers, suppliers and
                    business partners while delivering dependable
                    agro supply solutions.
                </p>

            </div>

        </div>

    </div>

</section>


<!-- ================= ABOUT CTA ================= -->

<section class="about-cta-section">

    <div class="container">

        <div class="about-cta-content text-center">

            <span>
                LET'S BUILD TOGETHER
            </span>

            <h2>
                Looking for a Reliable Agro Trading Partner?
            </h2>

            <p>
                Connect with Vearium Traders for your
                agricultural commodity requirements.
            </p>

            <a asp-controller="Enquiry"
               asp-action="Index"
               class="about-cta-btn">
                Get Bulk Enquiry
                <span>→</span>
            </a>

        </div>

    </div>

</section>