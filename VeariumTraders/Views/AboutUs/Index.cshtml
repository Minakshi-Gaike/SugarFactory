<!-- ABOUT US - OUR JOURNEY SECTION -->
<section class="about-journey-section">
    <div class="about-journey-container">

        <!-- Left Column -->
        <div class="about-journey-content">
            <h2>Our Journey</h2>

            <p>
                Vearium Traders is a proprietorship business engaged in
                agricultural commodity trading, procurement and bulk supply.
                Established in December 2022, we focus on building reliable
                relationships with customers, suppliers and business partners.
            </p>

            <p>
                We deal in agricultural commodities including maize, sugar,
                jaggery, jaggery powder, coconut shell and oil.
            </p>

            <p>
                Our aim is to provide dependable agro supply solutions
                through professional communication, trusted partnerships
                and a consistent focus on quality.
            </p>
        </div>

        <!-- Right Column -->
        <div class="about-journey-highlights">
            <h2>What Sets Us Apart</h2>

            <div class="about-highlight-item">
                <span>🌱</span>
                <p>
                    <strong>Reliable Sourcing:</strong>
                    Focus on dependable agricultural commodity sourcing.
                </p>
            </div>

            <div class="about-highlight-item">
                <span>🌍</span>
                <p>
                    <strong>Trading Relationships:</strong>
                    Building long-term relationships with suppliers and buyers.
                </p>
            </div>

            <div class="about-highlight-item">
                <span>📦</span>
                <p>
                    <strong>Quality Focus:</strong>
                    Attention to product quality and consistency.
                </p>
            </div>

            <div class="about-highlight-item">
                <span>🤝</span>
                <p>
                    <strong>Transparent Business:</strong>
                    Professional communication and dependable service.
                </p>
            </div>
        </div>

    </div>
</section>

<!-- OUR MISSION & VISION SECTION -->
<section class="mission-vision-section">
    <div class="mission-vision-container">

        <!-- Our Mission -->
        <div class="mission-vision-card">
            <div class="mission-vision-icon">🎯</div>

            <h2>Our Mission</h2>

            <p>
                To deliver dependable, compliant, and high-quality
                agricultural commodities to global markets through
                strong sourcing, disciplined execution, and ethical
                trade practices.
            </p>
        </div>

        <!-- Our Vision -->
        <div class="mission-vision-card">
            <div class="mission-vision-icon">🔭</div>

            <h2>Our Vision</h2>

            <p>
                To become a globally trusted agri-trade partner by
                transforming agricultural supply chains into
                transparent, efficient, and value-driven ecosystems.
            </p>
        </div>

    </div>
</section>

<!-- OUR CORE VALUES SECTION -->
<section class="core-values-section">
    <div class="core-values-container">

        <h2 class="core-values-title">Our Core Values</h2>

        <div class="core-values-grid">

            <div class="core-value-card">
                <div class="core-value-icon">🤝</div>
                <h3>Integrity</h3>
                <p>Transparent, ethical, and compliance-driven trade practices.</p>
            </div>

            <div class="core-value-card">
                <div class="core-value-icon">🎯</div>
                <h3>Quality</h3>
                <p>Strict sourcing, processing, and inspection standards.</p>
            </div>

            <div class="core-value-card">
                <div class="core-value-icon">🌍</div>
                <h3>Global Focus</h3>
                <p>Aligned with international trade norms and buyer expectations.</p>
            </div>

            <div class="core-value-card">
                <div class="core-value-icon">📦</div>
                <h3>Reliability</h3>
                <p>Consistent supply execution with end-to-end accountability.</p>
            </div>

            <div class="core-value-card">
                <div class="core-value-icon">🌱</div>
                <h3>Strong Origins</h3>
                <p>Deep-rooted sourcing from trusted agricultural networks.</p>
            </div>

            <div class="core-value-card">
                <div class="core-value-icon">🔐</div>
                <h3>Trust</h3>
                <p>Secure contracts, protected payments, and long-term partnerships.</p>
            </div>

        </div>
    </div>
</section>

