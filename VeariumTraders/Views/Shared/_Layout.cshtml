<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Vearium Traders</title>

    <!-- Bootstrap -->
    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Vearium Main CSS -->
    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    @await RenderSectionAsync("Styles", required: false)
</head>

<body>

   
    <!-- ================= NAVBAR ================= -->

    <header>

        <nav class="navbar navbar-expand-lg vearium-navbar">

            <div class="container">

                <!-- LOGO -->

                <a class="navbar-brand vearium-brand"
                   asp-controller="Home"
                   asp-action="Index">

                    <img src="~/images/logo/vearium_logo.png.jpeg"
                         alt="Vearium Traders Logo"
                         class="vearium-logo" />

                </a>


                <!-- MOBILE MENU BUTTON -->

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#veariumNavbar"
                        aria-controls="veariumNavbar"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>

                </button>


                <!-- NAVIGATION -->

                <div class="collapse navbar-collapse"
                     id="veariumNavbar">

                    <ul class="navbar-nav ms-auto align-items-lg-center">

                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Index">

                                Home

                            </a>

                        </li>


                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="AboutUs"
                               asp-action="Index">

                                About Us

                            </a>

                        </li>


                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="Products"
                               asp-action="Index">

                                Products

                            </a>

                        </li>


                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="Services"
                               asp-action="Index">

                                Services

                            </a>

                        </li>


                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="Agriculture"
                               asp-action="Index">

                                Agriculture & Trading

                            </a>

                        </li>


                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="Gallery"
                               asp-action="Index">

                                Gallery

                            </a>

                        </li>


                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="News"
                               asp-action="Index">

                                News

                            </a>

                        </li>


                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="Contact"
                               asp-action="Index">

                                Contact

                            </a>

                        </li>


                        <!-- ENQUIRY BUTTON -->

                        <li class="nav-item ms-lg-3">

                            <a class="nav-enquiry"
                               asp-controller="Enquiry"
                               asp-action="Index">

                                Get Enquiry
                            </a>

                        </li>

                    </ul>

                </div>

            </div>

        </nav>

    </header>


    <!-- ================= MAIN CONTENT ================= -->

    <main>

        @RenderBody()

    </main>

<!-- ================= FOOTER ================= -->

<footer class="vearium-footer">

    <div class="container">

        <div class="row gy-5">

            <!-- COMPANY -->
            <div class="col-lg-3 col-md-6">

                <div class="footer-company">

                    <img src="~/images/logo/vearium_logo.png.jpeg"
                         alt="Vearium Traders"
                         class="footer-logo" />

                    <p class="footer-company-text">
                        Vearium Traders is engaged in agricultural
                        commodity trading and bulk supply of quality
                        products.
                    </p>

                    <!-- SOCIAL MEDIA -->
                    <div class="footer-social">

                        <a href="#"
                           target="_blank"
                           aria-label="Facebook">
                            <i class="bi bi-facebook"></i>
                        </a>

                        <a href="#"
                           target="_blank"
                           aria-label="Instagram">
                            <i class="bi bi-instagram"></i>
                        </a>

                        <a href="#"
                           target="_blank"
                           aria-label="Twitter">
                            <i class="bi bi-twitter-x"></i>
                        </a>

                        <a href="#"
                           target="_blank"
                           aria-label="LinkedIn">
                            <i class="bi bi-linkedin"></i>
                        </a>

                    </div>

                </div>

            </div>


            <!-- QUICK LINKS -->
            <div class="col-lg-2 col-md-6">

                <div class="footer-column">

                    <h5>Quick Links</h5>

                    <span class="footer-heading-line"></span>

                    <ul class="footer-links">

                        <li>
                            <a asp-controller="Home"
                               asp-action="Index">
                                <i class="bi bi-chevron-right"></i>
                                Home
                            </a>
                        </li>

                        <li>
                            <a asp-controller="AboutUs"
                               asp-action="Index">
                                <i class="bi bi-chevron-right"></i>
                                About Us
                            </a>
                        </li>

                        <li>
                            <a asp-controller="Products"
                               asp-action="Index">
                                <i class="bi bi-chevron-right"></i>
                                Products
                            </a>
                        </li>

                        <li>
                            <a asp-controller="Services"
                               asp-action="Index">
                                <i class="bi bi-chevron-right"></i>
                                Services
                            </a>
                        </li>

                        <li>
                            <a asp-controller="Agriculture"
                               asp-action="Index">
                                <i class="bi bi-chevron-right"></i>
                                Agriculture & Trading
                            </a>
                        </li>

                        <li>
                            <a asp-controller="Gallery"
                               asp-action="Index">
                                <i class="bi bi-chevron-right"></i>
                                Gallery
                            </a>
                        </li>

                        <li>
                            <a asp-controller="News"
                               asp-action="Index">
                                <i class="bi bi-chevron-right"></i>
                                News
                            </a>
                        </li>

                        <li>
                            <a asp-controller="Contact"
                               asp-action="Index">
                                <i class="bi bi-chevron-right"></i>
                                Contact
                            </a>
                        </li>
                         <li>
                            <a href="Admin/Login">
                                <i class="bi bi-chevron-right"></i>
                               ADMIN LOGIN
                            </a>
                        </li>

                    </ul>

                </div>

            </div>


            <!-- PRODUCTS -->
            <div class="col-lg-2 col-md-6">

                <div class="footer-column">

                    <h5>Products</h5>

                    <span class="footer-heading-line"></span>

                    <ul class="footer-links">

                        <li>
                            <a href="#">
                                <i class="bi bi-chevron-right"></i>
                                Maize
                            </a>
                        </li>

                        <li>
                            <a href="#">
                                <i class="bi bi-chevron-right"></i>
                                Sugar
                            </a>
                        </li>

                        <li>
                            <a href="#">
                                <i class="bi bi-chevron-right"></i>
                                Jaggery
                            </a>
                        </li>

                        <li>
                            <a href="#">
                                <i class="bi bi-chevron-right"></i>
                                Jaggery Powder
                            </a>
                        </li>

                        <li>
                            <a href="#">
                                <i class="bi bi-chevron-right"></i>
                                Coconut Shell
                            </a>
                        </li>

                        

                    </ul>

                </div>

            </div>


            <!-- CONTACT -->
            <div class="col-lg-5 col-md-6">

                <div class="footer-column">

                    <h5>Contact Us</h5>

                    <span class="footer-heading-line"></span>


                    <!-- PHONE + EMAIL -->
                    <div class="footer-contact-top">

                        <div class="footer-contact-item">

                            <span class="footer-contact-icon">
                                <i class="bi bi-telephone-fill"></i>
                            </span>

                            <a href="tel:9028215279">
                                +91 9028215279
                            </a>

                        </div>


                        <div class="footer-contact-item">

                            <span class="footer-contact-icon">
                                <i class="bi bi-envelope-fill"></i>
                            </span>

                            <a href="mailto:veariumtraders@gmail.com">
                                veariumtraders@gmail.com
                            </a>

                        </div>

                    </div>


                    <!-- ADDRESSES -->
                    <div class="footer-address-wrapper">

                        <!-- REGISTERED OFFICE -->
                        <div class="footer-address-box">

                            <h6>
                                <i class="bi bi-geo-alt-fill"></i>
                                Registered Office
                            </h6>

                            <p>
                                Building No./Flat No.: 40/A/2<br />
                                Shivaji Chouk<br />
                                Yarand Galli<br />
                                Shirguppi, Belagavi<br />
                                Karnataka - 591237
                            </p>

                        </div>


                        <!-- OFFICE ADDRESS -->
                        <div class="footer-address-box">

                            <h6>
                                <i class="bi bi-building-fill"></i>
                                Office Address
                            </h6>

                            <p>
                                Shree Laxmi Park, Dhyari<br />
                                Near Maruti Mandir<br />
                                Dhyari, Pune - 411041<br />
                                B Wing, 302<br />
                                Vanita Desai
                            </p>

                        </div>

                    </div>


                    <!-- GSTIN -->
                    <div class="footer-gstin">

                        <strong>GSTIN:</strong>
                        29DSPPP3386A1ZA

                    </div>

                </div>

            </div>

        </div>


        <!-- FOOTER BOTTOM -->

        <div class="footer-bottom">

            <p>
                © @DateTime.Now.Year Vearium Traders.
                All Rights Reserved.
            </p>

            <p class="footer-bottom-tagline">
                Quality You Can Trust
            </p>

        </div>

    </div>

</footer>

    <!-- ================= JAVASCRIPT ================= -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>

            
<!-- Vendor Registration Floating Button -->
<a href="/Home/VendorRegistration" class="vendor-registration-float">
    <i class="bi bi-person-plus"></i>
    <span>Vendor Registration</span>
</a>

<!-- WhatsApp Floating Button -->
<a href="https://wa.me/91YOURNUMBER"
   class="whatsapp-float"
   target="_blank"
   rel="noopener noreferrer"
   aria-label="Chat with us on WhatsApp">
    <i class="bi bi-whatsapp"></i>
</a>
