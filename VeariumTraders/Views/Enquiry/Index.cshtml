@{
    ViewData["Title"] = "Bulk Enquiry";
}

<section class="enquiry-page">
    <div class="container">

        <div class="enquiry-header text-center">
            <span>VEARIUM TRADERS</span>

            <h1>
                <strong>Vendor Registration</strong>
            </h1>

            <p>
                Share your agricultural commodity requirements
                with us and our team will get back to you.
            </p>
        </div>

        <div class="row justify-content-center">

            <div class="col-lg-8">

                <div class="enquiry-card">

                    <form>

                        <div class="row g-3">

                            <div class="col-md-6">
                                <label class="form-label">
                                    Your Name
                                </label>

                                <input type="text"
                                       class="form-control"
                                       placeholder="Enter your name">
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">
                                    Company Name
                                </label>

                                <input type="text"
                                       class="form-control"
                                       placeholder="Enter company name">
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">
                                    Mobile Number
                                </label>

                                <input type="tel"
                                       class="form-control"
                                       placeholder="Enter mobile number">
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">
                                    Email Address
                                </label>

                                <input type="email"
                                       class="form-control"
                                       placeholder="Enter email address">
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">
                                    Select Product
                                </label>

                                <select class="form-select">
                                    <option selected disabled>
                                        Select product
                                    </option>

                                    <option>Maize</option>
                                    <option>Sugar</option>
                                    <option>Jaggery</option>
                                    <option>Jaggery Powder</option>
                                    <option>Coconut Shell</option>
                                </select>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">
                                    Required Quantity
                                </label>

                                <div class="row g-2">
                                    <div class="col-7">
                                        <input type="number"
                                               class="form-control"
                                               placeholder="Enter quantity"
                                               min="1">
                                    </div>

                                    <div class="col-5">
                                        <select class="form-select">
                                            <option selected disabled>Unit</option>
                                            <option value="kg">Kilogram (KG)</option>
                                            <option value="quintal">Quintal (Q)</option>
                                            <option value="mt">Metric Ton (MT)</option>
                                            <option value="other">Other</option>
                                        </select>
                                    </div>
                                </div>
                            </div>

                            <div class="col-12">
                                <label class="form-label">
                                    Your Requirement
                                </label>

                                <textarea class="form-control"
                                          rows="5"
                                          placeholder="Describe your requirement..."></textarea>
                            </div>

                            <div class="col-12 text-center">

                                <button type="submit"
                                        class="enquiry-submit-btn">
                                    Submit Enquiry
                                    <span>→</span>
                                </button>

                            </div>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>
</section>