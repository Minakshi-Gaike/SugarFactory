
@{
    ViewData["Title"] = "Agriculture & Trading Services";
}

<div class="services-page">

    <!-- HERO SECTION -->
    <section class="services-hero">
        <div class="services-hero-overlay"></div>

        <div class="services-hero-content">
            <span class="services-eyebrow">VEARIUM TRADERS</span>

            <h1>Our Comprehensive Services</h1>

            <p>
                End-to-end solutions for agricultural commodity trading,
                procurement and bulk supply. We connect businesses with
                suitable sourcing options and dependable supply coordination.
            </p>

            <a asp-controller="BulkEnquiry"
               asp-action="Index"
               class="services-primary-btn">
                Explore Our Services
            </a>
        </div>
    </section>


    <!-- SERVICES CARDS -->
    <section class="services-section">
        <div class="container">

            <div class="services-section-heading">
                <span>WHAT WE DO</span>
                <h2>Our Trading Services</h2>
                <p>
                    Flexible solutions for businesses looking for
                    agricultural commodities and bulk supply.
                </p>
            </div>

            <div class="row g-4">

                <div class="col-lg-4 col-md-6">
                    <div class="service-card service-card-blue">
                        <div class="service-icon">📦</div>
                        <h3>Trading Operations</h3>
                        <p>
                            Agricultural commodity sourcing and trading
                            based on business requirements.
                        </p>

                        <h4>Key Features</h4>
                        <ul>
                            <li>Commodity sourcing coordination</li>
                            <li>Bulk quantity requirements</li>
                            <li>Supplier coordination</li>
                            <li>Order and delivery planning</li>
                        </ul>

                        <a asp-controller="BulkEnquiry"
                           asp-action="Index"
                           class="service-link">
                            Enquire Now →
                        </a>
                    </div>
                </div>

                <div class="col-lg-4 col-md-6">
                    <div class="service-card service-card-green">
                        <div class="service-icon">🚚</div>
                        <h3>Supply & Distribution</h3>
                        <p>
                            Requirement-based supply coordination for
                            agricultural products and commodities.
                        </p>

                        <h4>Key Features</h4>
                        <ul>
                            <li>Product availability coordination</li>
                            <li>Bulk supply planning</li>
                            <li>Dispatch coordination</li>
                            <li>Delivery requirement support</li>
                        </ul>

                        <a asp-controller="BulkEnquiry"
                           asp-action="Index"
                           class="service-link">
                            Enquire Now →
                        </a>
                    </div>
                </div>

                <div class="col-lg-4 col-md-6">
                    <div class="service-card service-card-orange">
                        <div class="service-icon">🌾</div>
                        <h3>Commodity Procurement</h3>
                        <p>
                            Sourcing support for businesses seeking
                            specific agricultural commodities.
                        </p>

                        <h4>Key Features</h4>
                        <ul>
                            <li>Product requirement assessment</li>
                            <li>Quantity and specification discussion</li>
                            <li>Quality requirement coordination</li>
                            <li>Order planning support</li>
                        </ul>

                        <a asp-controller="BulkEnquiry"
                           asp-action="Index"
                           class="service-link">
                            Enquire Now →
                        </a>
                    </div>
                </div>

            </div>
        </div>
    </section>


    <!-- SERVICE PROCESS -->
    <section class="services-process-section">
        <div class="container">

            <div class="services-section-heading">
                <span>HOW WE WORK</span>
                <h2>Our Service Process</h2>
                <p>
                    A structured approach to understanding and coordinating
                    your commodity requirements.
                </p>
            </div>

            <div class="row g-3">

                <div class="col-lg-4 col-md-6">
                    <div class="process-card">
                        <span class="process-number">01</span>
                        <div>
                            <h3>Requirement Analysis</h3>
                            <p>Understand product, quantity and delivery needs.</p>
                        </div>
                    </div>
                </div>

                <div class="col-lg-4 col-md-6">
                    <div class="process-card">
                        <span class="process-number">02</span>
                        <div>
                            <h3>Sourcing & Supplier Coordination</h3>
                            <p>Coordinate sourcing according to requirements.</p>
                        </div>
                    </div>
                </div>

                <div class="col-lg-4 col-md-6">
                    <div class="process-card">
                        <span class="process-number">03</span>
                        <div>
                            <h3>Quality Requirements</h3>
                            <p>Discuss applicable specifications and quality needs.</p>
                        </div>
                    </div>
                </div>

                <div class="col-lg-6 col-md-6">
                    <div class="process-card">
                        <span class="process-number">04</span>
                        <div>
                            <h3>Order Finalization</h3>
                            <p>Confirm mutually agreed order and supply terms.</p>
                        </div>
                    </div>
                </div>

                <div class="col-lg-6 col-md-6">
                    <div class="process-card">
                        <span class="process-number">05</span>
                        <div>
                            <h3>Delivery Coordination</h3>
                            <p>Coordinate dispatch and delivery as agreed.</p>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </section>


    <!-- COMMODITY CAPABILITIES -->
    <section class="services-capabilities-section">
        <div class="container">

            <div class="services-section-heading">
                <span>OUR COMMODITIES</span>
                <h2>A Range of Agricultural Products</h2>
                <p>
                    Discuss your product specifications and bulk
                    requirements with our team.
                </p>
            </div>

            <div class="row g-4">

                <div class="col-lg-4 col-md-6">
                    <div class="capability-card">
                        <div class="capability-icon">🌽</div>
                        <h3>Maize</h3>
                        <p>Commodity sourcing based on required quantity and specifications.</p>
                    </div>
                </div>

                <div class="col-lg-4 col-md-6">
                    <div class="capability-card">
                        <div class="capability-icon">🧂</div>
                        <h3>Sugar</h3>
                        <p>Supply enquiries for business and bulk requirements.</p>
                    </div>
                </div>

                <div class="col-lg-4 col-md-6">
                    <div class="capability-card">
                        <div class="capability-icon">🟤</div>
                        <h3>Jaggery</h3>
                        <p>Discuss product requirements and supply quantities.</p>
                    </div>
                </div>

                <div class="col-lg-4 col-md-6">
                    <div class="capability-card">
                        <div class="capability-icon">🌾</div>
                        <h3>Jaggery Powder</h3>
                        <p>Requirement-based sourcing enquiries for jaggery powder.</p>
                    </div>
                </div>

                <div class="col-lg-4 col-md-6">
                    <div class="capability-card">
                        <div class="capability-icon">🥥</div>
                        <h3>Coconut Shell</h3>
                        <p>Discuss availability, specifications and required quantities.</p>
                    </div>
                </div>

                <div class="col-lg-4 col-md-6">
                    <div class="capability-card">
                        <div class="capability-icon">🛢️</div>
                        <h3>Oil</h3>
                        <p>Share your product type and bulk supply requirements.</p>
                    </div>
                </div>

            </div>
        </div>
    </section>


    <!-- WHY CHOOSE US -->
    <section class="services-benefits-section">
        <div class="container">

            <div class="services-section-heading">
                <span>OUR COMMITMENT</span>
                <h2>Why Choose Vearium Traders?</h2>
            </div>

            <div class="row g-4">

                <div class="col-lg-3 col-6">
                    <div class="benefit-card">
                        <div class="benefit-icon">🌍</div>
                        <h3>Business Network</h3>
                        <p>Commodity sourcing and supplier coordination.</p>
                    </div>
                </div>

                <div class="col-lg-3 col-6">
                    <div class="benefit-card">
                        <div class="benefit-icon">✓</div>
                        <h3>Quality Focus</h3>
                        <p>Attention to agreed product specifications.</p>
                    </div>
                </div>

                <div class="col-lg-3 col-6">
                    <div class="benefit-card">
                        <div class="benefit-icon">⚡</div>
                        <h3>Efficient Coordination</h3>
                        <p>Clear communication throughout the enquiry process.</p>
                    </div>
                </div>

                <div class="col-lg-3 col-6">
                    <div class="benefit-card">
                        <div class="benefit-icon">🤝</div>
                        <h3>Business Support</h3>
                        <p>Solutions aligned with customer requirements.</p>
                    </div>
                </div>

            </div>
        </div>
    </section>


    <!-- FINAL CTA -->
    <section class="services-cta-section">
        <div class="container">
            <div class="services-cta-box">

                <h2>Ready to Partner With Us?</h2>

                <p>
                    Share your agricultural commodity requirements
                    and connect with our team.
                </p>

                <div class="services-cta-actions">
                    <a asp-controller="Contact"
                       asp-action="Index"
                       class="services-cta-light-btn">
                        Get in Touch
                    </a>

                    <a asp-controller="BulkEnquiry"
                       asp-action="Index"
                       class="services-cta-outline-btn">
                        Bulk Enquiry
                    </a>
                </div>

            </div>
        </div>
    </section>

</div>
