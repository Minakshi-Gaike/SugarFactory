@{
    ViewData["Title"] = "Website Policies & Privacy Policy";
}

<style>
    .privacy-page {
        background: #f7f8fa;
        padding: 40px 15px;
        color: #273449;
        font-size: 14px;
        line-height: 1.8;
    }

    .privacy-card {
        max-width: 1000px;
        margin: 0 auto;
        padding: 35px;
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        box-shadow: 0 4px 18px rgba(0, 0, 0, 0.05);
    }

        .privacy-card h1 {
            color: #a84b1b;
            font-size: 30px;
            font-weight: 700;
            margin-bottom: 8px;
        }

    .privacy-company {
        font-weight: 600;
        color: #17324d;
        margin-bottom: 4px;
    }

    .privacy-updated {
        color: #6b7280;
        font-size: 12px;
        margin-bottom: 25px;
    }

    .privacy-section {
        margin-bottom: 28px;
    }

        .privacy-section h2 {
            color: #17324d;
            font-size: 20px;
            font-weight: 700;
            margin-bottom: 12px;
        }

        .privacy-section h3 {
            color: #a84b1b;
            font-size: 16px;
            font-weight: 700;
            margin: 16px 0 8px;
        }

        .privacy-section ul {
            padding-left: 24px;
            margin-bottom: 12px;
        }

        .privacy-section li {
            margin-bottom: 5px;
        }

    .privacy-contact {
        background: #f5f4dc;
        border-left: 4px solid #b5a94b;
        border-radius: 6px;
        padding: 20px;
        margin-top: 25px;
    }

        .privacy-contact h2 {
            color: #604b16;
            font-size: 20px;
            font-weight: 700;
            margin-bottom: 12px;
        }

        .privacy-contact a {
            color: #a84b1b;
            text-decoration: none;
        }

            .privacy-contact a:hover {
                text-decoration: underline;
            }

    @@media (max-width: 576px) {
        .privacy-page {
            padding: 20px 10px;
        }

        .privacy-card {
            padding: 20px 16px;
        }

            .privacy-card h1 {
                font-size: 24px;
            }

        .privacy-section h2 {
            font-size: 18px;
        }
    }
</style>

<div class="privacy-page">
    <div class="privacy-card">

        <h1>Website Policies &amp; Privacy Policy</h1>

        <p class="privacy-company">
            Vearium Traders Private Limited
        </p>

        <p class="privacy-updated">
            Last Updated: 10/14/2026
        </p>

        <section class="privacy-section">
            <h2>1. About Us</h2>

            <p>
                Vearium Traders
                Private Limited is engaged in
                agri-commodity trading, processing, sourcing, and
                supply of agricultural products including food grains,
                spices, sugar, and allied agro products. The company
                operates in compliance with applicable Indian laws
                and ethical business practices.
            </p>
        </section>

        <section class="privacy-section">
            <h2>2. Privacy Policy</h2>

            <h3>Information We Collect</h3>

            <ul>
                <li>Name, company name, email address, phone number</li>
                <li>Business inquiry details</li>
                <li>Website usage data (cookies, IP address)</li>
            </ul>

            <h3>Use of Information</h3>

            <ul>
                <li>To respond to inquiries and business proposals</li>
                <li>For internal records and communication</li>
                <li>To improve our services and website experience</li>
            </ul>

            <p>
                We do not sell, rent, or share personal information
                with third parties except where required by law or
                contractual obligations.
            </p>
        </section>

        <section class="privacy-section">
            <h2>3. Terms &amp; Conditions</h2>

            <ul>
                <li>Website information is for general business purposes only</li>
                <li>Pricing and specifications may change without notice</li>
                <li>Transactions are governed by written contracts or POs</li>
                <li>Unauthorized use of content is prohibited</li>
            </ul>
        </section>

        <section class="privacy-contact">
            <h2>Contact Information</h2>

            <p class="mb-1">
                <strong>Vearium Traders Private Limited</strong>
            </p>

            <p class="mb-0">
                <strong>Email:</strong>
                <a href="mailto:info@VeariumTraders.in">
                    info@VeariumTraders.in
                </a>
            </p>
        </section>

    </div>
</div>
