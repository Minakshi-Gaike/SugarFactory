@{
    ViewData["Title"] = "Quality Policy & Guarantee";
}

<style>
    .quality-page {
        background: #f7f8fa;
        padding: 40px 15px;
        color: #273449;
        font-size: 14px;
        line-height: 1.8;
    }

    .quality-card {
        max-width: 1000px;
        margin: 0 auto;
        padding: 35px;
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        box-shadow: 0 4px 18px rgba(0, 0, 0, 0.05);
    }

        .quality-card h1 {
            color: #a84b1b;
            font-size: 30px;
            font-weight: 700;
            margin-bottom: 22px;
        }

    .quality-intro {
        margin-bottom: 28px;
    }

    .quality-section {
        margin-bottom: 28px;
    }

        .quality-section h2 {
            color: #17324d;
            font-size: 20px;
            font-weight: 700;
            margin-bottom: 12px;
        }

        .quality-section ul {
            padding-left: 24px;
            margin-bottom: 12px;
        }

        .quality-section li {
            margin-bottom: 7px;
        }

    .quality-quote {
        background: #f5f4dc;
        border-left: 4px solid #b5a94b;
        border-radius: 6px;
        padding: 20px;
        margin-top: 30px;
        color: #604b16;
        font-weight: 700;
        font-style: italic;
        font-size: 16px;
    }

    @@media (max-width: 576px) {
        .quality-page {
            padding: 20px 10px;
        }

        .quality-card {
            padding: 20px 16px;
        }

            .quality-card h1 {
                font-size: 25px;
            }

        .quality-section h2 {
            font-size: 18px;
        }
    }
</style>

<div class="quality-page">
    <div class="quality-card">

        <h1>Quality Policy &amp; Guarantee</h1>

        <p class="quality-intro">
            Vearium Traders Private Limited is committed to delivering
            agro commodities that consistently meet customer requirements,
            statutory regulations, and international trade standards.
        </p>

        <section class="quality-section">
            <h2>Our Quality Commitments</h2>

            <ul>
                <li>Source from reliable and ethical suppliers</li>
                <li>Ensure traceability and buyer specification compliance</li>
                <li>Maintain consistency in quality and presentation</li>
                <li>Comply with food safety and regulatory standards</li>
                <li>Conduct regular inspections and verifications</li>
                <li>Ensure accurate documentation</li>
                <li>Continuously improve quality systems</li>
            </ul>
        </section>

        <section class="quality-section">
            <h2>Implementation &amp; Responsibility</h2>

            <p>
                Quality is the responsibility of every employee, associate,
                and partner. Management ensures adequate resources,
                training, and oversight.
            </p>
        </section>

        <div class="quality-quote">
            “Quality is cultivated at the source and delivered with integrity.”
        </div>

    </div>
</div>
